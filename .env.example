# Database
# Production (epic-agent-studio on Railway): DATABASE_URL=${{Postgres.DATABASE_URL}}
#   → resolves to postgres.railway.internal (private, NO egress fees)
# Local dev only: copy DATABASE_PUBLIC_URL from the Postgres plugin (your machine → cloud)
#   → never set DATABASE_PUBLIC_URL on the epic-agent-studio service
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@HOST:PORT/railway

# Auth.js / NextAuth
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=https://your-app.up.railway.app
NEXT_PUBLIC_SITE_URL=https://your-app.up.railway.app

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that get PLATFORM_ADMIN on first sign-in
PLATFORM_ADMIN_EMAILS=you@gmail.com

# Stripe — run: npx tsx scripts/setup-stripe.ts (after STRIPE_SECRET_KEY set)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_WEEKLY=price_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# AI generation backends
GROQ_API_KEY=
PIXIO_API_KEY=
HF_TOKEN=